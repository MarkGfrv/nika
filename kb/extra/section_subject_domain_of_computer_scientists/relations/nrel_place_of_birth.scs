nrel_place_of_birth
<- sc_node_non_role_relation;
=> nrel_main_idtf:
	[место рождения*]
	(* <- lang_ru;; *);
	[place of birth*]
	(* <- lang_en;; *);
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_first_domain: concept_computer_scientist;
=> nrel_second_domain: concept_node;
=> nrel_definitional_domain:
	...
	(*
	<= nrel_combination:
		{
			concept_computer_scientist;
			concept_node
		};;
	*);;
