nrel_author
<- sc_node_non_role_relation;
=> nrel_main_idtf:
	[автор*]
	(* <- lang_ru;; *);
	[author*]
	(* <- lang_en;; *);
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_first_domain: concept_sorting_algorithm;
=> nrel_second_domain: concept_computer_scientist;
=> nrel_definitional_domain:
	...
	(*
	<= nrel_combination:
		{
			concept_sorting_algorithm;
			concept_computer_scientist
		};;
	*);;
